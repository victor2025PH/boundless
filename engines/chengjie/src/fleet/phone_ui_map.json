      "flows": {
        "post": [
          {"op": "key", "key": "home"},
          {"op": "tap", "anchor": "app_icon", "expect": "change"},
          {"op": "tap", "anchor": "feed_tab", "expect": "change"},
          {"op": "tap", "anchor": "composer_open", "expect": "change"},
          {"op": "tap", "anchor": "composer_field"},
          {"op": "text", "field": "text"},
          {"op": "tap", "anchor": "post_submit"}
        ],
        "post_media": [
          {"op": "key", "key": "home"},
          {"op": "tap", "anchor": "app_icon", "expect": "change"},
          {"op": "tap", "anchor": "feed_tab", "expect": "change"},
          {"op": "tap", "anchor": "composer_open", "expect": "change"},
          {"op": "tap", "anchor": "photo_button", "expect": "change"},
          {"op": "tap", "anchor": "gallery_0", "slot_field": "media_slot", "slot_stride": "gallery_stride"},
          {"op": "tap", "anchor": "media_next"},
          {"op": "tap", "anchor": "composer_field"},
          {"op": "text", "field": "text"},
          {"op": "tap", "anchor": "post_submit"}
        ],
        "like": [
          {"op": "key", "key": "home"},
          {"op": "tap", "anchor": "app_icon", "expect": "change"},
          {"op": "tap", "anchor": "feed_tab", "expect": "change"},
          {"op": "swipe", "from": "feed_swipe_from", "to": "feed_swipe_to", "duration_ms": 350, "repeat": "scrolls", "expect": "change"},
          {"op": "tap", "anchor": "like_button"}
        ],
        "comment": [
          {"op": "key", "key": "home"},
          {"op": "tap", "anchor": "app_icon", "expect": "change"},
          {"op": "tap", "anchor": "feed_tab", "expect": "change"},
          {"op": "swipe", "from": "feed_swipe_from", "to": "feed_swipe_to", "duration_ms": 350, "repeat": "scrolls", "expect": "change"},
          {"op": "tap", "anchor": "comment_open", "expect": "change"},
          {"op": "tap", "anchor": "comment_field"},
          {"op": "text", "field": "text"},
          {"op": "tap", "anchor": "comment_send"}
        ],
        "follow": [
          {"op": "key", "key": "home"},
          {"op": "tap", "anchor": "app_icon", "expect": "change"},
          {"op": "tap", "anchor": "search_open", "expect": "change"},
          {"op": "tap", "anchor": "search_field"},
          {"op": "text", "field": "handle"},
          {"op": "tap", "anchor": "search_first", "expect": "change"},
          {"op": "tap", "anchor": "follow_button"}
        ],
        "warmup": [
          {"op": "key", "key": "home"},
          {"op": "tap", "anchor": "app_icon", "expect": "change"},
          {"op": "tap", "anchor": "feed_tab", "expect": "change"},
          {"op": "repeat", "count": "scrolls", "steps": [
            {"op": "swipe", "from": "feed_swipe_from", "to": "feed_swipe_to", "duration_ms": 350, "expect": "change"},
            {"op": "dwell", "lo_ms": 600, "hi_ms": 1400},
            {"op": "dwell", "lo_ms": 1800, "hi_ms": 4200, "when": "dwell", "every": 3},
            {"op": "tap", "anchor": "like_button", "when": "like"}
          ]}
